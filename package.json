{
  "name": "the-curated-nook",
  "version": "1.0.0",
  "description": "The Curated Nook - MERN Project",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "vite --config frontend/vite.config.js",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green --raw \"npm run server\" \"npm run client\"",
    "build-frontend": "cd frontend && npx vite build --config vite.config.js",
    "prepare-backend": "echo 'Backend prepared'",
    "debug": "ls -la && cd frontend && ls -la && npx vite --version",
    "render-build": "npm install && npm run build-frontend && npm run prepare-backend",
    "render-start": "node backend/server.js"
  },
  "keywords": [],
  "author": "Shcoobz",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@reduxjs/toolkit": "^2.2.6",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "mongoose": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.25.1",
    "react-spinners": "^0.14.1",
    "uuid": "^10.0.0",
    "vite": "^5.3.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "nodemon": "^3.1.4"
  }
}
